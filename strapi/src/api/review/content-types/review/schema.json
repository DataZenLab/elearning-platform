{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Review"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "rating": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 5
    },
    "comment": {
      "type": "text"
    },
    "firebaseUid": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "userAvatar": {
      "type": "string"
    },
    "isApproved": {
      "type": "boolean",
      "default": true
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "reviews"
    },
    "userEmail": {
      "type": "email"
    }
  }
}
